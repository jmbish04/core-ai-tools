---
/**
 * @fileoverview `/assets/[id]` — one asset, and every image descended from it.
 *
 * Thin shell: the island fetches the asset, its iterations and the folder names,
 * so this file only supplies the shell and the route param. The sub-nav comes
 * from the shared route table, so it matches `/assets` and the pill does not
 * shift when an asset is opened.
 */
import ShellLayout from "@/layouts/ShellLayout.astro";
import { AssetDetail } from "@/components/evolution/AssetDetail";
import { shellNavFor } from "@/lib/nav";

const { id } = Astro.params;
---

<ShellLayout
  title="Asset"
  description="One asset, and every image that descends from it."
  {...shellNavFor(Astro.url.pathname)}
>
  <div class="mx-auto w-full max-w-[90rem] px-4 pb-16 sm:px-6">
    <AssetDetail id={id!} client:load />
  </div>
</ShellLayout>
