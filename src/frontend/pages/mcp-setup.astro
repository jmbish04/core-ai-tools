---
import BaseLayout from "@/layouts/BaseLayout.astro";

const MCP_URL = "https://core-ai-tools.hacolby.workers.dev/mcp";
const tools = [
  ["create_session", "Start a session from a library image."],
  ["list_sessions / list_sessions_for_image", "Find sessions; every session spawned from an image."],
  ["get_session_tree", "The revision tree, retry attempts grouped."],
  ["submit_edit", "Create a revision (returns immediately; progress streams to the web UI). Send an idempotency_key."],
  ["retry_revision / fork_revision", "Another attempt of an edit / branch from any node."],
  ["create_mask", "bbox / polygon / raster / semantic (natural-language region)."],
  ["approve_revision / reject_revision", "HITL gate — approve from Claude without opening a browser."],
  ["list_available_models", "The model registry: ids, capabilities, cost."],
  ["get_prompt_templates", "Retrieve best-practice templates BEFORE composing a prompt."],
  ["promote_prompt / grade_revision", "Promote a good prompt; grade a result + failure mode."],
];
---

<BaseLayout title="MCP Setup" description="Connect the core-ai-tools MCP server to Claude or any MCP client.">
  <main class="container mx-auto flex max-w-3xl flex-col gap-8 px-4 py-12">
    <header class="flex flex-col gap-2">
      <div class="flex items-center gap-3">
        <span class="text-4xl">🔌</span>
        <h1 class="text-3xl font-semibold tracking-tight">MCP Setup</h1>
      </div>
      <p class="text-base text-muted-foreground">
        Drive a session from Claude (or any MCP client). Start in the browser, walk away, continue
        from Claude — new revisions appear in the open tab in realtime.
      </p>
    </header>

    <section class="flex flex-col gap-3 rounded-lg bg-card p-5 ring-1 ring-border/40">
      <h2 class="text-sm uppercase tracking-wide text-muted-foreground">Endpoint</h2>
      <code class="rounded bg-background/60 px-3 py-2 font-mono text-sm ring-1 ring-border/40">{MCP_URL}</code>
      <p class="text-sm text-muted-foreground">
        JSON-RPC 2.0 over Streamable HTTP. Implements <code>initialize</code>, <code>tools/list</code>,
        and <code>tools/call</code>.
      </p>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-sm uppercase tracking-wide text-muted-foreground">Add as a custom connector</h2>
      <p class="text-sm text-muted-foreground">
        In Claude (Settings → Connectors → Add custom connector), point it at the endpoint above. Or in
        a local MCP client, add:
      </p>
      <pre class="overflow-x-auto rounded-lg bg-background/60 p-4 text-xs ring-1 ring-border/40"><code>{`{
  "mcpServers": {
    "core-ai-tools": {
      "url": "${MCP_URL}"
    }
  }
}`}</code></pre>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-sm uppercase tracking-wide text-muted-foreground">Quick test</h2>
      <pre class="overflow-x-auto rounded-lg bg-background/60 p-4 text-xs ring-1 ring-border/40"><code>{`curl -s ${MCP_URL} \\
  -H 'Content-Type: application/json' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}'`}</code></pre>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-sm uppercase tracking-wide text-muted-foreground">Tools</h2>
      <ul class="divide-y divide-border/40 rounded-lg bg-card ring-1 ring-border/40">
        {tools.map(([name, desc]) => (
          <li class="flex flex-col gap-0.5 px-4 py-3">
            <code class="font-mono text-sm">{name}</code>
            <span class="text-xs text-muted-foreground">{desc}</span>
          </li>
        ))}
      </ul>
      <p class="text-xs text-muted-foreground">
        Every tool is session-scoped and its results are visible in the web UI in realtime. Image
        generation returns a compact payload with a delivery URL + a deep link into the app — no image
        bytes unless you ask. Note: live model generation is still being wired; read/organise tools work
        fully today.
      </p>
    </section>
  </main>
</BaseLayout>
