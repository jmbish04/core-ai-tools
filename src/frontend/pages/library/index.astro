---
/**
 * @fileoverview `/library` — every image in the workspace, flat.
 *
 * The flat counterpart to `/folders`: same rows, without the tree. Useful when
 * you know what a picture looks like but not where it was filed.
 */
import ShellLayout from "@/layouts/ShellLayout.astro";
import { LibraryGrid } from "@/components/library/LibraryGrid";
import { shellNavFor } from "@/lib/nav";
---

<ShellLayout
  title="Images"
  description="Every image in the workspace — source photos and everything generated from them."
  {...shellNavFor(Astro.url.pathname)}
>
  {/* No page header: the island renders its own title and stats. Two of them
      is what the folder hero and contents header did, one level up. */}
  <div class="mx-auto w-full max-w-[90rem] px-4 pb-16 sm:px-6">
    <LibraryGrid client:load />
  </div>
</ShellLayout>
