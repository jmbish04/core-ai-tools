---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SessionDetail } from "@/components/sessions/SessionDetail";
import { AssistantModal } from "@/components/assistant/AssistantModal";

const { uuid } = Astro.params;
---

<BaseLayout title="Session" description="Session detail — revision tree, realtime edits, and a session-aware assistant.">
  <main class="container mx-auto flex max-w-7xl flex-col gap-6 px-4 py-12">
    <SessionDetail uuid={uuid!} client:load />
  </main>

  {/* Quiet, session-scoped assistant. Takes no layout space until opened, then
      floats over the workbench — so the tree + image stage keep full width. */}
  <AssistantModal
    client:only="react"
    agentName={`session-chat-${uuid!}`}
    buttonLabel="Session assistant"
    title="Session assistant"
    description="Knows this session — ask why an edit failed or what to try next."
    welcomeTitle="Ask about this session"
    welcomeSubtitle="I can see this session's revision tree, models, and edit history."
    placeholder="e.g. Why did the last edit fail? What model should I try next?"
    welcomeSuggestions={[
      "Summarize what happened in this session",
      "Why did the latest revision fail?",
      "Suggest a better prompt for the last edit",
      "Which model fits this edit best?",
    ]}
  />
</BaseLayout>
