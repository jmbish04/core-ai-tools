---
/**
 * @fileoverview `/assistant` — several assistant conversations at once.
 *
 * Thread list on the left, the conversation on the right; each thread is its own
 * ChatBroker Durable Object instance. Browser-only for the same reason `/chat`
 * is: `agents/react`'s `useAgent` cannot run in the SSR worker.
 */
import ShellLayout from "@/layouts/ShellLayout.astro";
import { AssistantWorkspace } from "@/components/assistant/AssistantWorkspace";
import { shellNavFor } from "@/lib/nav";
---

<ShellLayout
  title="Assistant threads"
  description="Several persistent assistant conversations, each backed by its own Durable Object."
  {...shellNavFor(Astro.url.pathname)}
>
  <div class="mx-auto w-full max-w-[90rem] px-4 pb-16 sm:px-6">
    <header class="mb-6">
      <h2 class="text-foreground text-lg font-semibold">Threads</h2>
      <p class="text-muted-foreground mt-1 max-w-2xl text-sm">
        Keep more than one conversation going. Each thread remembers itself, so you can leave
        one mid-thought and come back to it.
      </p>
    </header>
    <AssistantWorkspace client:only="react" />
  </div>
</ShellLayout>
