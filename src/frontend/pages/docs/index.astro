---
/**
 * @fileoverview `/docs` — how this workspace is built, and how to drive it.
 *
 * `/docs` is an Astro SSR page, NOT an API path: `isApiPath()` in `_worker.ts`
 * deliberately excludes it, and the docs metadata API lives under `/api/docs/*`.
 *
 * The agent grid binds to the live `GET /api/docs/agents` through the
 * `DocsAgentsSection` island — real Durable Objects, no mock data.
 */
import ShellLayout from "@/layouts/ShellLayout.astro";
import { CodeBlock } from "@/components/ui/code-block";
import { DocsAgentsSection } from "@/components/docs";
import { shellNavFor } from "@/lib/nav";

const stackRows: { area: string; tech: string; note: string }[] = [
  { area: "Runtime", tech: "Cloudflare Workers", note: "One Worker serving SSR, the API, the MCP server and the Durable Objects" },
  { area: "Frontend", tech: "Astro + React islands", note: "SSR pages, interactive islands, ReUI on a dark-first theme" },
  { area: "API", tech: "Hono + zod-openapi", note: "Zod-validated routes; the OpenAPI 3.1 document is generated from them" },
  { area: "Database", tech: "D1 + Drizzle ORM", note: "One table per file under db/schemas/<domain>/; migrations only ever stack" },
  { area: "Realtime", tech: "Durable Objects", note: "FolderDO and SessionDO broadcast changes to open tabs over WebSocket" },
  { area: "Models", tech: "core-guardian", note: "Every inference is routed for budget and breaker checks, and its usage recorded" },
];

const apiSurfaces: { href: string; label: string; desc: string }[] = [
  { href: "/openapi.json", label: "openapi.json", desc: "The OpenAPI 3.1 document for the whole API, generated from the route schemas." },
  { href: "/scalar", label: "Scalar", desc: "Interactive API reference." },
  { href: "/swagger", label: "Swagger UI", desc: "Classic try-it-out request explorer." },
  { href: "/api/health", label: "/api/health", desc: "Structured health check across D1 and every Durable Object binding." },
];

const concepts: { title: string; body: string; href?: string; cta?: string }[] = [
  {
    title: "A project is a folder",
    body:
      "There is no separate projects table. A project is a folder that has settings on it — a default prompt, context, a use case — and the onboarding wizard ends by creating one.",
    href: "/projects/new",
    cta: "Start a project",
  },
  {
    title: "Settings inherit, and say where from",
    body:
      "A folder that sets nothing uses the nearest ancestor that does. Every setting is shown with the folder it came from, because an inherited prompt is indistinguishable from a local one until you are told — and then you edit the wrong folder.",
    href: "/folders",
    cta: "Open folders",
  },
  {
    title: "Nothing is overwritten",
    body:
      "Each edit is a node in a tree. Retrying stacks as another attempt of the same edit; going a different way branches. A failed attempt is kept, and you can fork from it.",
    href: "/sessions",
    cta: "See sessions",
  },
  {
    title: "Everything traces to its asset",
    body:
      "Promote an image to an asset and every picture later made from it stays attributed to it — through forks and retries — so one source's whole history reads in order.",
    href: "/assets",
    cta: "Browse assets",
  },
];

const quickstart = `# Install and run the dev server
pnpm install
pnpm dev

# Apply local D1 migrations (generate, then apply)
pnpm migrate:local

# The gates, both of which must be clean before a deploy
pnpm test
pnpm typecheck`;

const codeModeExample = `// tools/list advertises three tools, not thirty. One execute call
// chains as many named tools as the job needs, in one round trip.
const result = await call_tool("execute", {
  code: \`async () => {
    const images = await call_tool("list_library", { limit: 5 });
    const session = await call_tool("create_session", {
      library_image_id: images[0].id,
    });
    return await call_tool("submit_edit", {
      session_uuid: session.session_uuid,
      prompt_text: "warmer light, keep the cabinetry",
      idempotency_key: crypto.randomUUID(),
    });
  }\`,
});`;
---

<ShellLayout
  title="Docs"
  description="How this workspace is built — the stack, the ideas it is organised around, the live API reference, and the Durable Objects behind it."
  {...shellNavFor(Astro.url.pathname)}
>
  <div class="mx-auto w-full max-w-5xl px-4 pb-20 sm:px-6">
    <header class="mb-12">
      <h2 class="text-foreground text-2xl font-semibold tracking-tight">Docs</h2>
      <p class="text-muted-foreground mt-3 max-w-3xl text-sm leading-relaxed">
        A folder-organised image workspace on one Cloudflare Worker: Astro SSR pages, a
        Zod-validated Hono API over D1, an MCP server in code mode, and image models routed
        through core-guardian. Start in your folders, or connect a client over MCP.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <a
          href="/folders"
          class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-md px-4 py-2 text-sm font-medium transition-colors"
        >
          Open folders
        </a>
        <a
          href="/connect"
          class="bg-muted hover:bg-muted/70 rounded-md px-4 py-2 text-sm font-medium transition-colors"
        >
          Connect over MCP
        </a>
      </div>
    </header>

    <!-- The ideas, before the machinery -->
    <section class="mb-14">
      <h3 class="text-foreground mb-1 text-lg font-semibold">How it is organised</h3>
      <p class="text-muted-foreground mb-6 max-w-3xl text-sm">
        Four decisions explain most of the product. They are deliberate, and the reasons are
        worth knowing before changing anything.
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        {concepts.map((c) => (
          <article class="bg-card border-border flex flex-col rounded-lg border p-5">
            <h4 class="text-foreground text-sm font-semibold">{c.title}</h4>
            <p class="text-muted-foreground mt-2 flex-1 text-sm leading-relaxed">{c.body}</p>
            {c.href ? (
              <a href={c.href} class="text-foreground mt-4 text-sm font-medium underline-offset-4 hover:underline">
                {c.cta} &rarr;
              </a>
            ) : null}
          </article>
        ))}
      </div>
    </section>

    <!-- Stack -->
    <section class="mb-14">
      <h3 class="text-foreground mb-1 text-lg font-semibold">The stack</h3>
      <p class="text-muted-foreground mb-6 max-w-3xl text-sm">
        One Worker. Each row is a real layer of this codebase.
      </p>
      <div class="bg-card border-border divide-border divide-y overflow-hidden rounded-lg border">
        {stackRows.map((row) => (
          <div class="grid grid-cols-1 gap-1 px-5 py-4 sm:grid-cols-[7rem_13rem_1fr] sm:items-center sm:gap-4">
            <span class="text-muted-foreground text-[11px] font-medium tracking-wide uppercase">{row.area}</span>
            <span class="text-foreground font-mono text-sm">{row.tech}</span>
            <span class="text-muted-foreground text-sm">{row.note}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- MCP in code mode -->
    <section class="mb-14">
      <h3 class="text-foreground mb-1 text-lg font-semibold">MCP is in code mode</h3>
      <p class="text-muted-foreground mb-6 max-w-3xl text-sm">
        Tool definitions are re-sent on every request of every session, so advertising 39
        tools costs about 4,000 tokens per turn. This server advertises three —
        <code>search</code>, <code>get_schema</code>, <code>execute</code> — and the rest stay
        dispatchable behind them. Measured: 365 tokens instead of 4,046.
      </p>
      <CodeBlock client:visible filename="one execute call" language="ts" code={codeModeExample} />
    </section>

    <!-- Live API docs -->
    <section class="mb-14">
      <h3 class="text-foreground mb-1 text-lg font-semibold">Live API reference</h3>
      <p class="text-muted-foreground mb-6 max-w-3xl text-sm">
        Generated from the route schemas, served by the Worker — so it cannot describe an
        endpoint that is not there.
      </p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {apiSurfaces.map((surface) => (
          <a
            href={surface.href}
            class="group bg-card border-border hover:border-border/70 flex flex-col rounded-lg border p-5 transition-colors"
          >
            <div class="mb-1 flex items-center justify-between gap-2">
              <span class="text-foreground font-mono text-sm">{surface.label}</span>
              <span aria-hidden="true" class="text-muted-foreground transition-transform group-hover:translate-x-0.5">&rarr;</span>
            </div>
            <span class="text-muted-foreground text-sm">{surface.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Durable Objects (live) -->
    <section class="mb-14">
      <h3 class="text-foreground mb-1 text-lg font-semibold">Durable Objects</h3>
      <p class="text-muted-foreground mb-6 max-w-3xl text-sm">
        Loaded live from <code>GET /api/docs/agents</code>. These are the classes this Worker
        exports and binds — nothing that was deleted in a DO migration appears here.
      </p>
      <DocsAgentsSection client:visible />
    </section>

    <!-- Running it -->
    <section>
      <h3 class="text-foreground mb-1 text-lg font-semibold">Running it locally</h3>
      <p class="text-muted-foreground mb-6 max-w-3xl text-sm">
        Node 22+ and <code>pnpm</code>. <code>pnpm build</code> does not typecheck, so both
        gates below are separate.
      </p>
      <CodeBlock client:visible filename="terminal" language="bash" code={quickstart} />
    </section>
  </div>
</ShellLayout>
