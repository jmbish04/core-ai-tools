---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { AssistantModal } from "@/components/assistant/AssistantModal";

const entries = [
  { href: "/library", icon: "🖼️", title: "Image Library", desc: "Source photos & generated assets. Organize folders and launch new editing sessions." },
  { href: "/sessions", icon: "🌿", title: "Editing Sessions", desc: "Non-destructive revision tree DAG. Pan, zoom, fork, retry, and diff compare." },
  { href: "/models", icon: "🧠", title: "Declarative Model Catalog", desc: "Selectable model registry with capability flags (Mask inpainting, Video, Segmentation) & task defaults." },
  { href: "/prompts", icon: "📝", title: "Prompt & Evidence Library", desc: "Proven prompt templates with revision track record ratings and techniques." },
  { href: "/mcp-setup", icon: "🔌", title: "Claude MCP Interop", desc: "Drive sessions headlessly from Claude.ai or desktop MCP clients live over WebSocket." },
  { href: "/chat", icon: "💬", title: "AI Assistant", desc: "Interactive AI assistant powered by Cloudflare Agents SDK." },
];
---

<BaseLayout
  title="core-ai-tools — Session-based AI Image Editing Platform"
  description="Session-based AI image editing platform — non-destructive revision tree, diff viewer, mask brush, REST, MCP, and live WebSockets."
>
  <div class="container mx-auto max-w-7xl px-4 py-12">
    <!-- Hero Section -->
    <section className="mb-16 flex flex-col gap-6 rounded-2xl bg-card p-8 md:p-12 ring-1 ring-border/40 relative overflow-hidden">
      <div className="flex items-center gap-2">
        <span className="rounded-full bg-primary/10 px-3 py-1 font-mono text-xs font-semibold text-primary ring-1 ring-primary/30">
          Cloudflare Workers &bull; Astro SSR &bull; D1 &bull; Durable Objects &bull; CF Images
        </span>
      </div>

      <h1 className="max-w-4xl text-4xl sm:text-5xl font-semibold tracking-tight text-foreground leading-[1.15]">
        Session-based AI image editing with non-destructive revision trees.
      </h1>

      <p className="max-w-3xl text-base sm:text-lg leading-relaxed text-muted-foreground">
        Pick a source photo, describe edits in natural language or structured JSON, and every attempt is recorded as a node in a revision tree. Fork from any point, retry edits without destroying history, and compare perspective drift with our 3-mode diff viewer.
      </p>

      <div className="flex flex-wrap gap-4 pt-2">
        <a href="/sessions">
          <Button size="lg" className="gap-2 bg-primary text-primary-foreground font-medium py-6 px-6">
            Open Sessions Workspace &rarr;
          </Button>
        </a>
        <a href="/library">
          <Button size="lg" variant="outline" className="gap-2 font-medium py-6 px-6 ring-1 ring-border/40">
            Browse Image Library
          </Button>
        </a>
        <a href="/mcp-setup">
          <Button size="lg" variant="ghost" className="gap-2 text-muted-foreground hover:text-foreground">
            Connect Claude MCP
          </Button>
        </a>
      </div>
    </section>

    {/* Platform Entry Points */}
    <section className="mb-16">
      <h2 className="mb-6 font-mono text-xs uppercase tracking-widest text-muted-foreground">
        PLATFORM SURFACES
      </h2>

      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {entries.map((e) => (
          <a href={e.href} className="block group">
            <Card className="h-full bg-card ring-1 ring-border/40 transition-all hover:ring-primary/50">
              <CardHeader className="pb-2">
                <div className="mb-2 text-3xl">{e.icon}</div>
                <CardTitle className="text-base font-semibold group-hover:text-primary transition-colors">
                  {e.title}
                </CardTitle>
              </CardHeader>
              <CardContent>
                <CardDescription className="text-xs text-muted-foreground leading-relaxed">
                  {e.desc}
                </CardDescription>
              </CardContent>
            </Card>
          </a>
        ))}
      </div>
    </section>

    {/* Architectural Highlights */}
    <section className="mb-8">
      <h2 className="mb-6 font-mono text-xs uppercase tracking-widest text-muted-foreground">
        ARCHITECTURE &amp; INTEROPERABILITY
      </h2>

      <div className="grid grid-cols-1 gap-5 md:grid-cols-3">
        <div className="rounded-xl bg-card p-6 ring-1 ring-border/40 flex flex-col gap-2">
          <span className="font-mono text-xs text-primary font-bold">01 &bull; ONE CORE, THREE SURFACES</span>
          <h3 className="font-semibold text-foreground text-sm">Identical REST, MCP &amp; UI capabilities</h3>
          <p className="text-xs text-muted-foreground leading-relaxed">
            Every operation — session creation, revision submission, forking, retrying, mask authoring, and HITL approval — runs through one unified domain core.
          </p>
        </div>

        <div className="rounded-xl bg-card p-6 ring-1 ring-border/40 flex flex-col gap-2">
          <span className="font-mono text-xs text-primary font-bold">02 &bull; NON-DESTRUCTIVE DAG TREE</span>
          <h3 className="font-semibold text-foreground text-sm">Revision DAG &amp; Retry Stacking</h3>
          <p className="text-xs text-muted-foreground leading-relaxed">
            Every edit produces a node in a revision graph. Retries of an edit stack as attempt iterations inside one node, while new directions branch into distinct forks.
          </p>
        </div>

        <div className="rounded-xl bg-card p-6 ring-1 ring-border/40 flex flex-col gap-2">
          <span className="font-mono text-xs text-primary font-bold">03 &bull; REALTIME SYNC &amp; DIFF VIEWER</span>
          <h3 className="font-semibold text-foreground text-sm">WebSockets &amp; Perspective Drift Check</h3>
          <p className="text-xs text-muted-foreground leading-relaxed">
            Per-session Durable Objects stream progress events to open tabs. Compare revisions with Slider, Side-by-Side, or Onion Skin mode with structural drift edge overlay.
          </p>
        </div>
      </div>
    </section>
  </div>

  <AssistantModal client:only="react" />
</BaseLayout>
