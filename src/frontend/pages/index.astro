---
/**
 * @fileoverview `/` — the landing page.
 *
 * Section `home` matches no rail record on purpose: nothing in the rail is
 * current here, and the brand mark is the way back to this page. The cards are
 * the product's real screens, in the order someone new should meet them.
 *
 * The page is otherwise static: it makes no API call, so it renders the same
 * before and after there is anything in the workspace.
 */
import ShellLayout from "@/layouts/ShellLayout.astro";
import { AssistantModal } from "@/components/assistant/AssistantModal";
import { shellNavFor } from "@/lib/nav";

const start: { href: string; title: string; desc: string }[] = [
  {
    href: "/projects/new",
    title: "Start a project",
    desc: "Name it, pick what it works from, and say what the models should do. A project is a folder, so it inherits from whatever it sits inside.",
  },
  {
    href: "/folders",
    title: "Work in a folder",
    desc: "The tree, the images in the folder you picked, and the prompt and context in force there — each shown with the folder it came from. An agent sits beside it and edits the tree for you.",
  },
  {
    href: "/compare",
    title: "Compare models",
    desc: "State one intent, run it on several models at once, and read each pane with the exact prompt that model was given. The prompt is usually why one came out better.",
  },
];

const then: { href: string; title: string; desc: string }[] = [
  {
    href: "/assets",
    title: "Assets",
    desc: "Images you keep coming back to. Everything later made from one stays traceable to it, through forks and retries.",
  },
  {
    href: "/sessions",
    title: "Sessions",
    desc: "One image's edit history as a tree. Retries stack as attempts; nothing you tried is thrown away.",
  },
  {
    href: "/models",
    title: "Models",
    desc: "Which model runs which kind of work. Nothing is promoted automatically — the table here is what dispatch reads.",
  },
  {
    href: "/prompts",
    title: "Prompts",
    desc: "Wordings that worked, scored by the results they actually produced.",
  },
  {
    href: "/connect",
    title: "Connect over MCP",
    desc: "Drive all of it from Claude. Start in the browser, carry on from a chat — the open tab keeps up in realtime.",
  },
  {
    href: "/docs",
    title: "Docs",
    desc: "How it is built, the ideas it is organised around, and the live API reference.",
  },
];
---

<ShellLayout
  title="core-ai-tools"
  description="A folder-organised AI image workspace: nested projects with inheritable settings, an agent that edits the tree beside you, and every picture traceable to the asset it came from."
  {...shellNavFor(Astro.url.pathname)}
>
  <div class="mx-auto w-full max-w-6xl px-4 pb-20 sm:px-6">
    <section class="bg-card border-border mb-12 rounded-xl border p-6 sm:p-10">
      <p class="text-muted-foreground font-mono text-[11px] tracking-widest uppercase">
        Folders · Assets · Agent · Multi-model
      </p>
      <h2 class="text-foreground mt-4 max-w-3xl text-2xl leading-tight font-semibold tracking-tight sm:text-4xl">
        An image workspace organised the way you already think about the work.
      </h2>
      <p class="text-muted-foreground mt-5 max-w-2xl text-sm leading-relaxed sm:text-base">
        Images live in nested folders. Each folder carries the prompt, context and use case
        every edit inside it starts from, inherited from the folder above unless you say
        otherwise. An agent works beside the tree through the same tools an MCP client uses,
        and nothing is ever overwritten — every attempt is a node you can go back to.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="/projects/new"
          class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-md px-5 py-2.5 text-sm font-medium transition-colors"
        >
          Start a project
        </a>
        <a
          href="/folders"
          class="bg-muted hover:bg-muted/70 rounded-md px-5 py-2.5 text-sm font-medium transition-colors"
        >
          Open the workspace
        </a>
      </div>
    </section>

    <section class="mb-12">
      <h3 class="text-muted-foreground mb-5 font-mono text-[11px] tracking-widest uppercase">
        Where to start
      </h3>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        {start.map((card) => (
          <a
            href={card.href}
            class="group bg-card border-border hover:border-border/70 flex flex-col rounded-lg border p-5 transition-colors"
          >
            <span class="text-foreground text-base font-semibold">{card.title}</span>
            <span class="text-muted-foreground mt-2 flex-1 text-sm leading-relaxed">{card.desc}</span>
            <span aria-hidden="true" class="text-muted-foreground mt-4 text-sm transition-transform group-hover:translate-x-0.5">
              &rarr;
            </span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h3 class="text-muted-foreground mb-5 font-mono text-[11px] tracking-widest uppercase">
        Everything else
      </h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {then.map((card) => (
          <a
            href={card.href}
            class="group bg-card border-border hover:border-border/70 flex flex-col rounded-lg border p-5 transition-colors"
          >
            <span class="text-foreground text-sm font-semibold">{card.title}</span>
            <span class="text-muted-foreground mt-2 text-sm leading-relaxed">{card.desc}</span>
          </a>
        ))}
      </div>
    </section>
  </div>

  <AssistantModal client:only="react" />
</ShellLayout>
