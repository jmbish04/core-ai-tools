---
/**
 * @fileoverview `/folders` — the workspace. Nested folder tree, the selected
 * folder's images, and the settings in force there with their provenance.
 *
 * The organiser is a `client:load` island: it owns selection, fetching and the
 * folder WebSocket. It reads real D1 rows through `/api` — there is no mock
 * folder tree anywhere in this build, deliberately, because a mock tree is the
 * first thing to drift from the real one.
 */
import ShellLayout from "@/layouts/ShellLayout.astro";
import { FolderOrganiser } from "@/components/folders/FolderOrganiser";
import { shellNavFor } from "@/lib/nav";

// Read on the server so the island's first render matches the browser's. Taking
// it from `window.location` inside the island instead meant every `?folder=`
// link hydrated with a mismatch and React threw the server render away.
const initialFolderId = Astro.url.searchParams.get("folder");
---

<ShellLayout
  title="Folders"
  description="Nested project folders — images, prompts and context in one tree."
  {...shellNavFor(Astro.url.pathname)}
>
  <div class="mx-auto w-full max-w-[110rem] px-4 pb-16 sm:px-6">
    <FolderOrganiser initialFolderId={initialFolderId} client:load />
  </div>
</ShellLayout>
