---
/**
 * @fileoverview SettingsLayout — shared chrome for every `/settings/*` page.
 *
 * Wraps `ShellLayout` (the app shell, dark-first) and lays out two columns: the
 * `SettingsNav` sub-navigation on the left, which collapses to a horizontal
 * scroller on mobile, and the section content on the right.
 *
 * The shell's pill nav is left EMPTY for settings (see `lib/nav.ts`): printing
 * the same five links in the pill and again in the left column would be the
 * duplication this layout exists to avoid.
 *
 * The active route is read from `Astro.url.pathname` and passed to the island so
 * the right section is highlighted on first paint, before hydration.
 *
 * Usage (from a page):
 *   <SettingsLayout title="Preferences" description="…">
 *     <SomeIsland client:load />
 *   </SettingsLayout>
 */

import ShellLayout from "@/layouts/ShellLayout.astro";
import { SettingsNav } from "@/components/settings";
import { shellNavFor } from "@/lib/nav";

const { title, description } = Astro.props;

// Normalise the active path (drop any trailing slash) so it matches the
// hrefs declared in SETTINGS_SECTIONS exactly.
const active = Astro.url.pathname.replace(/\/$/, "");
---

<ShellLayout
  title={`${title} · Settings`}
  description={description}
  {...shellNavFor(Astro.url.pathname)}
>
  <div class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6">
    <header class="mb-8 flex flex-col gap-2">
      <h2 class="text-foreground text-lg font-semibold">Settings</h2>
      <p class="text-muted-foreground max-w-2xl text-sm">
        Workspace preferences, notification delivery, outbound webhooks, audit history and
        advanced controls.
      </p>
    </header>

    <div class="grid gap-8 md:grid-cols-[minmax(0,13.75rem)_minmax(0,1fr)]">
      <aside class="min-w-0 md:sticky md:top-20 md:self-start">
        <SettingsNav active={active} client:load />
      </aside>
      <section class="min-w-0">
        <slot />
      </section>
    </div>
  </div>
</ShellLayout>
